# Local development only. scripts/setup_local.py generates private signing keys.
DATABASE_URL=sqlite:///.local/classroom.db
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=.local/artifacts
LOCAL_STORAGE_SIGNING_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Existing, administrator-provisioned account emails, comma-separated.
# Public registration cannot claim an allowlisted teacher email.
TEACHER_EMAILS=

# Class management and notebook preparation work without this key.
# AI checks, hints, reveals and exam generation require actual credentials.
GEMINI_API_KEY=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
JWT_ALG=HS256
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_NAME=refresh_token
COOKIE_PATH=/

# Production: use PostgreSQL and STORAGE_BACKEND=r2 (the default when unset),
# apply Alembic migrations, and set a strong JWT_SECRET and these R2 credentials.
# DATABASE_URL=postgresql+psycopg://...
# STORAGE_BACKEND=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_ENDPOINT_URL=
# R2_REGION=auto

# Optional tracing (leave empty when disabled).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
