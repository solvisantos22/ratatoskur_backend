# Required
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
JWT_SECRET="replace-with-a-long-random-secret"
GEMINI_API_KEY="replace-with-your-gemini-api-key"

# Auth / cookie settings (defaults shown)
JWT_ALG="HS256"
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_NAME="refresh_token"
COOKIE_SECURE=false
COOKIE_SAMESITE="lax"
COOKIE_PATH="/"

# Cloudflare R2 (required for /query artifact storage)
R2_ACCOUNT_ID="your-r2-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="your-r2-bucket-name"

# R2 optional overrides
R2_ENDPOINT_URL="https://your-r2-account-id.r2.cloudflarestorage.com"
R2_REGION="auto"

# Langfuse (optional tracing)
LANGFUSE_PUBLIC_KEY="pk-lf-..."
LANGFUSE_SECRET_KEY="sk-lf-..."
# You can use either LANGFUSE_HOST or LANGFUSE_BASE_URL.
LANGFUSE_HOST="https://cloud.langfuse.com"
LANGFUSE_BASE_URL="https://cloud.langfuse.com"
