# Local development only. scripts/setup_local.py generates private signing keys.
DATABASE_URL=sqlite:///.local/classroom.db
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=.local/artifacts
LOCAL_STORAGE_SIGNING_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Existing, administrator-provisioned account emails, comma-separated.
# Public registration cannot claim an allowlisted teacher email.
TEACHER_EMAILS=

# Class management and notebook preparation work without this key.
# AI checks, hints, reveals and exam generation require actual credentials.
GEMINI_API_KEY=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
JWT_ALG=HS256
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_NAME=refresh_token
COOKIE_PATH=/

# Production: use PostgreSQL and STORAGE_BACKEND=r2 (the default when unset),
# apply Alembic migrations, and set a strong JWT_SECRET and these R2 credentials.
# DATABASE_URL=postgresql+psycopg://...
# STORAGE_BACKEND=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_ENDPOINT_URL=
# R2_REGION=auto

# Optional tracing (leave empty when disabled).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ---------------------------------------------------------------------------
# Everything below is OPTIONAL. Values shown are the defaults baked into the
# code; uncomment only to override. Nothing here needs setting to deploy.
# ---------------------------------------------------------------------------

# Free-text deployment label, attached to Langfuse traces only.
# ENVIRONMENT=

# Browser origins allowed to call this API directly, comma-separated.
# Leave empty unless a browser client starts calling the backend cross-origin.
# The iPad app is native and the teacher portal proxies server-side, so
# neither needs this.
# CORS_ALLOW_ORIGINS=https://portal.example.is,http://127.0.0.1:3000

# --- Model and routing (backend/llm.py) ---
# Primary Gemini model for every product call.
# LLM_GEMINI_MODEL=gemini-3.8-flash
# Set false to disable all fallbacks and use the primary route only.
# LLM_ROUTING_ENABLED=true
# Explicit fallback chain, comma-separated provider:model:effort.
# Overrides the default chain. Providers: gemini, openai, anthropic.
# Note: Gemini 3.8 Flash rejects the "minimal" thinking level.
# LLM_FALLBACK_CHAIN=
# LLM_MAX_RETRIES_PER_ROUTE=2
# LLM_ROUTE_MAX_WORKERS=8
# LLM_PROVIDER_HTTP_TIMEOUT_SECONDS=60

# --- Soft timeouts, seconds (when to give up and try the next route) ---
# LLM_REASONING_SOFT_TIMEOUT_SECONDS=15
# LLM_LEGIBILITY_SOFT_TIMEOUT_SECONDS=8
# Deferred/background error analysis has no soft timeout unless set.
# LLM_DEFERRED_SOFT_TIMEOUT_SECONDS=

# --- Fallback providers (a route is only added when its key is present) ---
# OPENAI_API_KEY=
# LLM_OPENAI_MODEL=gpt-5-mini
# LLM_OPENAI_REASONING_EFFORT=low
# ANTHROPIC_API_KEY=
# LLM_ANTHROPIC_MODEL=claude-3-5-haiku-20241022
# LLM_ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
# LLM_ANTHROPIC_VERSION=2023-06-01
# LLM_ANTHROPIC_MAX_TOKENS=2048

# --- Cost estimation and spike warnings ---
# Gemini 3.8 Flash paid tier through 2026-12-31; both double on 2027-01-01
# to 1.50 / 7.50. Update these when that happens.
# INPUT_COST_PER_1M_TOKENS_USD=0.75
# OUTPUT_COST_PER_1M_TOKENS_USD=3.75
# COST_SPIKE_THRESHOLD_USD=0.005

# --- Student /query upload limits ---
# These do NOT apply to teacher exercise-set uploads, which use fixed limits
# in backend/routes/classroom.py (12 images, 7 MB each, 30 MB combined).
# QUERY_MAX_SINGLE_FILE_BYTES=7340032
# QUERY_MAX_TOTAL_BYTES=15728640
# QUERY_MAX_PAGE_COUNT=12
# QUERY_MAX_IMAGE_PIXELS=16000000
# Longest edge, in pixels, of the downscaled copy sent to legibility checks.
# LEGIBILITY_MAX_IMAGE_SIDE=1600

# --- Prompt variants (directories under backend/prompts/) ---
# QUERY_PROMPT_VARIANT=v6
# QUERY_EXPERT_PROMPT_VARIANT=v4
# QUERY_LEGIBILITY_PROMPT_VARIANT=v4
